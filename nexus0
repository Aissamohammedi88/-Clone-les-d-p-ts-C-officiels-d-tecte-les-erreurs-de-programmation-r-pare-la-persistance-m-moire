def lire(chemin):
try:
with open(chemin, "r", encoding="utf-8", errors="ignore") as f:
return f.read()
except OSError:
return ""


def ecrire(chemin, contenu):
try:
with open(chemin, "w", encoding="utf-8") as f:
f.write(contenu)
return True
except OSError:
return False


# Erreurs communes + corrections
CORRECTIONS = [
# 1. Fuites memoire : malloc sans free (dans les exemples)
{
"nom": "malloc sans free",
"pattern": re.compile(r"(\w+)\s*=\s*(?:\([^)]+\)\s*)?malloc\s*\(([^)]+)\);", re.M),
"fix": None, # Juste detecter, ne pas corriger automatiquement (dangereux)
},

# 2. Espaces apres les parentheses (style Microsoft)
{
"nom": "espaces parasites",
"pattern": re.compile(r"\(\s+(\w)", re.M),
"fix": lambda m: "(" + m.group(1),
},

# 3. std::cout manquant
{
"nom": "cout sans std::",
"pattern": re.compile(r"(?<!std::)(?<!\w)cout\s*<<", re.M),
"fix": lambda m: "std::cout <<",
},
{
"nom": "cin sans std::",
"pattern": re.compile(r"(?<!std::)(?<!\w)cin\s*>>", re.M),
"fix": lambda m: "std::cin >>",
},
{
"nom": "endl sans std::",
"pattern": re.compile(r"(?<!std::)(?<!\w)endl\b", re.M),
"fix": lambda m: "std::endl",
},

# 4. int main() sans return
{
"nom": "int main sans return",
"pattern": re.compile(r"(int\s+main\s*\([^)]*\)\s*\{)((?:(?!\breturn\b)[^}])*)\}", re.S),
"fix": lambda m: m.group(1) + m.group(2) + "return 0;\n}",
},

# 5. using namespace std (mauvaise pratique)
{
"nom": "using namespace std",
"pattern": re.compile(r"^using\s+namespace\s+std\s*;", re.M),
"fix": None, # Detecter seulement
},

# 6. Pointeurs nus sans delete
{
"nom": "new sans delete",
"pattern": re.compile(r"(\w+)\s*=\s*new\s+(\w+)\s*[\(;]", re.M),
"fix": None,
},

# 7. Variables non initialisees
{
"nom": "variables non initialisees",
"pattern": re.compile(r"^\s*(int|long|float|double|char|bool)\s+(\w+)\s*;", re.M),
"fix": lambda m: " " + m.group(1) + " " + m.group(2) + " = 0;",
},

# 8. gets() (dangereux)
{
"nom": "gets() dangereux",
"pattern": re.compile(r"\bgets\s*\(", re.M),
"fix": lambda m: "fgets(", # Approximatif, mais mieux que gets
},

# 9. strcpy sans limite
{
"nom": "strcpy non securise",
"pattern": re.compile(r"\bstrcpy\s*\(", re.M),
"fix": lambda m: "strncpy(", # Plus sur
},

# 10. sprintf sans limite
{
"nom": "sprintf non securise",
"pattern": re.compile(r"\bsprintf\s*\(", re.M),
"fix": lambda m: "snprintf(", # Plus sur
},

# 11. Comparaison = au lieu de ==
{
"nom": "= dans if (probable)",
"pattern": re.compile(r"if\s*\(\s*(\w+)\s*=\s*(\w+)\s*\)", re.M),
"fix": lambda m: "if (" + m.group(1) + " == " + m.group(2) + ")", # ATTENTION : peut etre voulu
},

# 12. Include guards manquants
{
"nom": "pragma once au lieu de #ifndef",
"pattern": re.compile(r"^#pragma\s+once", re.M),
"fix": None, # Les deux sont acceptables
},
]


def analyser_fichier_cpp(chemin):
contenu = lire(chemin)
if not contenu:
return None

resultat = {
"chemin": chemin,
"nom": os.path.basename(chemin),
"taille": len(contenu),
"lignes": contenu.count("\n") + 1,
"erreurs": [],
"corrections": [],
"corrigible": False,
}

for correct in CORRECTIONS:
matches = list(correct["pattern"].finditer(contenu))
if matches:
resultat["erreurs"].append({
"type": correct["nom"],
"occurrences": len(matches),
})
if correct["fix"]:
resultat["corrections"].append({
"type": correct["nom"],
"occurrences": len(matches),
"pattern": correct["pattern"],
"fix": correct["fix"],
})

resultat["corrigible"] = len(resultat["corrections"]) > 0
return resultat


def corriger_fichier(chemin_source, chemin_dest, corrections):
contenu = lire(chemin_source)
if not contenu:
return False

original = contenu
for c in corrections:
try:
contenu = c["pattern"].sub(c["fix"], contenu)
except Exception:
continue

if contenu == original:
return False

return ecrire(chemin_dest, contenu)


# ===============================================================
# PERSISTANCE MEMOIRE
# ===============================================================

def reparer_persistance_memoire(chemin_source, chemin_dest):
"""
Repare les problemes de persistance memoire :
- Ajoute RAII pour les ressources (unique_ptr, shared_ptr)
- Ferme les fichiers non fermes
- Remplace les pointeurs nus par des smart pointers
"""
contenu = lire(chemin_source)
if not contenu:
return False, []

original = contenu
changements = []

# 1. Ajouter #include <memory> si pointeurs detectes
if re.search(r"\bnew\s+\w+", contenu) and "#include <memory>" not in contenu:
if "#include" in contenu:
contenu = re.sub(
r"(#include[^\n]+\n)",
r"\1#include <memory>\n",
contenu,
count=1,
)
changements.append("Ajout #include <memory>")

# 2. Remplacer FILE* par ifstream (si fichier)
if re.search(r"fopen\s*\(", contenu) and "#include <fstream>" not in contenu:
if "#include" in contenu:
contenu = re.sub(
r"(#include[^\n]+\n)",
r"\1#include <fstream>\n",
contenu,
count=1,
)
changements.append("Ajout #include <fstream>")

# 3. Ajouter destructeur si classe avec pointeur
pattern_classe = re.compile(r"(class\s+\w+\s*\{)", re.M)
if pattern_classe.search(contenu) and re.search(r"\w+\s*\*\s*\w+;", contenu):
changements.append("Classe avec pointeur brut detectee (RAII recommande)")

# 4. Detecter mutex sans lock_guard
if re.search(r"\bstd::mutex\b", contenu) and "lock_guard" not in contenu:
changements.append("Mutex sans lock_guard (deadlock possible)")

# 5. Detecter threads sans join
if re.search(r"\bstd::thread\b", contenu) and ".join()" not in contenu:
changements.append("Thread sans join() (fuite de thread)")

if contenu != original:
if ecrire(chemin_dest, contenu):
return True, changements
return False, changements


# ===============================================================
# SCAN + FIX
