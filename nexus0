def scanner_dossier(source_dir):
fichiers = []
for root, dirs, files in os.walk(source_dir):
if ".git" in root:
continue
for f in files:
if f.endswith((".cpp", ".cc", ".cxx", ".c", ".h", ".hpp", ".hxx", ".ipp")):
fichiers.append(os.path.join(root, f))
return fichiers


def traiter_fichier(chemin, source_dir, fixed_dir):
try:
analyse = analyser_fichier_cpp(chemin)
if not analyse:
return None

rel = os.path.relpath(chemin, source_dir)
dest = os.path.join(fixed_dir, rel)

# Creer le dossier parent
os.makedirs(os.path.dirname(dest), exist_ok=True)

# Copier d'abord
try:
shutil.copy2(chemin, dest)
except OSError:
pass

corrige = False
changements = []

# 1. Appliquer les corrections style
if analyse["corrigible"]:
if corriger_fichier(chemin, dest, analyse["corrections"]):
corrige = True
for c in analyse["corrections"]:
changements.append("Fix: " + c["type"] + " (" + str(c["occurrences"]) + ")")

# 2. Reparer la persistance memoire
fix_mem, changements_mem = reparer_persistance_memoire(dest, dest)
if fix_mem:
corrige = True
for ch in changements_mem:
changements.append("Memoire: " + ch)

analyse["corrige"] = corrige
analyse["changements"] = changements
analyse["dest"] = dest

return analyse
except Exception as e:
return {
"chemin": chemin,
"nom": os.path.basename(chemin),
"erreur": str(e)[:200],
}


