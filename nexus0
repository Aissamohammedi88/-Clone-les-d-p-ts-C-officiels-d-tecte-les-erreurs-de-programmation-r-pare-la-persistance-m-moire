def log(msg):
ts = time.strftime("%Y-%m-%d %H:%M:%S")
line = "[{}] {}".format(ts, msg)
try:
print(line, flush=True)
except Exception:
pass
try:
with open(LOG_FILE, "a", encoding="utf-8") as f:
f.write(line + "\n")
except OSError:
pass


def which(cmd):
for p in os.environ.get("PATH", "").split(os.pathsep):
if not p:
continue
full = os.path.join(p, cmd)
if os.path.isfile(full) and os.access(full, os.X_OK):
return full
return None


def supprimer(chemin):
if os.path.isdir(chemin):
shutil.rmtree(chemin, ignore_errors=True)
elif os.path.isfile(chemin):
try:
os.remove(chemin)
except OSError:
pass


def telecharger(url, dest, timeout=300):
log(" Telechargement : " + url)
try:
req = urllib.request.Request(url, headers={
"User-Agent": "Mozilla/5.0 NexusCppFixer/1.0",
"Accept": "*/*",
})
with urllib.request.urlopen(req, timeout=timeout, context=CTX) as r:
total = 0
with open(dest, "wb") as f:
while True:
chunk = r.read(131072)
if not chunk:
break
f.write(chunk)
total += len(chunk)
log(" OK " + str(total) + " octets")
return total > 1000
except Exception as e:
log(" Echec : " + str(e)[:150])
return False


def extraire_tarball(tar_path, dest):
try:
with tarfile.open(tar_path, "r:gz") as tar:
members = tar.getnames()
if not members:
return None
prefixe = members[0].split("/")[0]
temp = os.path.join(BASE, "_tmp_extract")
supprimer(temp)
os.makedirs(temp, exist_ok=True)
tar.extractall(temp)
source = os.path.join(temp, prefixe)
if not os.path.isdir(source):
return None
supprimer(dest)
shutil.move(source, dest)
supprimer(temp)
return dest
except Exception as e:
log(" Extraction echec : " + str(e)[:150])
return None


def cloner_depot(depot):
nom = depot["nom"]
git_url = depot["git"]
tarball_url = depot["tarball"]
branche = depot.get("branche", "main")

log("=== CLONE : " + nom + " ===")

# Dossier dedie pour ce depot
nom_court = nom.split("(")[-1].strip(")").replace("/", "_")
dest = os.path.join(SOURCE_DIR, nom_court)
supprimer(dest)

git = which("git")
if git:
log(" Methode 1 : git clone")
for br in [branche, "main", "master"]:
try:
code = subprocess.call(
[git, "clone", "--depth", "1", "--single-branch", "--branch", br, git_url, dest],
timeout=600,
stdout=subprocess.DEVNULL,
stderr=subprocess.DEVNULL,
)
if code == 0 and os.path.isdir(dest):
log(" Clone OK : " + dest)
return dest
except Exception as e:
log(" Echec git : " + str(e)[:80])
supprimer(dest)

log(" Methode 2 : tarball")
tarball = os.path.join(BASE, "_cpp_source.tar.gz")
if not telecharger(tarball_url, tarball):
log(" Echec telechargement tarball")
return None
res = extraire_tarball(tarball, dest)
supprimer(tarball)
if res:
log(" Tarball OK : " + res)
return res
return None


