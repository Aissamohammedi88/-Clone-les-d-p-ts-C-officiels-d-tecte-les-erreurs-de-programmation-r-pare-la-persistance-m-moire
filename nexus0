def ecrire_rapport(resultats, depots_traites):
total_fichiers = len(resultats)
avec_erreurs = [r for r in resultats if r and r.get("erreurs")]
corriges = [r for r in resultats if r and r.get("corrige")]

# Agreger les types d'erreurs
types_erreurs = {}
for r in avec_erreurs:
for e in r.get("erreurs", []):
t = e["type"]
types_erreurs[t] = types_erreurs.get(t, 0) + e["occurrences"]

doc = {
"version": VERSION,
"auteur": AUTEUR,
"licence": LICENCE,
"date": datetime.datetime.now(datetime.timezone.utc).isoformat(),
"depots": depots_traites,
"total_fichiers_scannes": total_fichiers,
"avec_erreurs": len(avec_erreurs),
"corriges": len(corriges),
"types_erreurs": types_erreurs,
"details": resultats,
}
doc["hash_sha256"] = hashlib.sha256(
json.dumps(doc, sort_keys=True, default=str).encode()
).hexdigest()

try:
with open(REPORT_JSON, "w", encoding="utf-8") as f:
json.dump(doc, f, indent=2, ensure_ascii=False, default=str)
log("JSON : " + REPORT_JSON)
except OSError:
pass

md = []
md.append("# NEXUS C++ CLONE + FIXER v" + VERSION)
md.append("")
md.append("**Auteur :** " + AUTEUR)
md.append("**Date :** " + doc["date"])
md.append("**Depots traites :** " + str(len(depots_traites)))
md.append("**SHA-256 :** `" + doc["hash_sha256"] + "`")
md.append("")
md.append("## Synthese")
md.append("")
md.append("- Fichiers scannes : " + str(total_fichiers))
md.append("- Avec erreurs detectees : " + str(len(avec_erreurs)))
md.append("- Corriges : " + str(len(corriges)))
md.append("")
md.append("## Types d'erreurs detectees")
md.append("")
md.append("| Type | Occurrences |")
md.append("|------|-------------|")
for t, n in sorted(types_erreurs.items(), key=lambda x: -x[1]):
md.append("| " + t + " | " + str(n) + " |")
md.append("")
md.append("## Depots")
md.append("")
for d in depots_traites:
md.append("- **" + d["nom"] + "** — " + d["categorie"])
md.append(" - Source : " + d.get("source", "?"))
md.append(" - Fichiers C++ : " + str(d.get("fichiers", 0)))
md.append("")
md.append("## Corrections appliquees")
md.append("")
md.append("Les corrections incluent :")
md.append("")
md.append("- **Style** : espaces parasites, std:: manquant, return dans main")
md.append("- **Securite** : gets → fgets, strcpy → strncpy, sprintf → snprintf")
md.append("- **Memoire** : ajout #include <memory>, <fstream>")
md.append("- **Persistance** : detection pointeurs bruts, mutex, threads")
md.append("")

try:
with open(REPORT_MD, "w", encoding="utf-8") as f:
f.write("\n".join(md))
log("MD : " + REPORT_MD)
except OSError:
pass

return doc


